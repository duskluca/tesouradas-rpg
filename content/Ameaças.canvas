    {
      "id": "914cfd682c5214fc",
      "type": "text",
      "text": "###### 85 PV\n\n**Físico 1d10**\n**Mente 1d4**\n**Emoção 1d8**\n\nAtletismo 1d8\nLuta 1d10\nFurtividade 1d12",
      "ffcBorder": "none",
