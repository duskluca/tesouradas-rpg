    {
      "id": "bfcc9839198ba8c6",
      "type": "text",
      "text": "###### 12 PV\n\n**Físico 1d8**\n**Mente 1d4**\n**Emoção 1d4**\n\nAtletismo 1d6\nLuta 1d6\nPercepção 1d8\nVigor 1d6",
      "ffcBorder": "none",
