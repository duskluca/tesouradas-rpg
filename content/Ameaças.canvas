    {
      "id": "91169b2a9f627cff",
      "type": "text",
      "text": "###### 60 PV\n\n**Físico 1d6**\n**Mente 1d20**\n**Emoção 1d8**\n\nPercepção 1d20\nAtletismo 1d6\nLuta 1d8",
      "ffcBorder": "none",
      "styleAttributes": {
