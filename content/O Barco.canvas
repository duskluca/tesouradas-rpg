    },
    {
      "id": "84c980bbd4df28fd",
      "type": "text",
      "text": "**Pontos de afinidade**\n\nGaspar <span class=\"bolinha preenchida\"></span><span class=\"bolinha preenchida\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span>\nPoti <span class=\"bolinha preenchida\"></span><span class=\"bolinha preenchida\"></span><span class=\"bolinha preenchida\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span>\nPhilippe <span class=\"bolinha preenchida\"></span><span class=\"bolinha preenchida\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span>\nEvangeline <span class=\"bolinha preenchida\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span>\nClarissa <span class=\"bolinha preenchida\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span>\nBento <span class=\"bolinha preenchida\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span><span class=\"bolinha\"></span>",
      "bcTextAlign": "left",
